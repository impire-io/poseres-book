<!-- Social link cards. og:image must be an absolute URL, so this points at
     the deployed site; local builds carry the production link harmlessly. -->
<meta property="og:type" content="website">
<meta property="og:site_name" content="The PRA Book">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="Why frozen models fail, what a sensorimotor triplet is, and how a population of competing frames learns structure nobody specified.">
<meta property="og:image" content="https://impire.io/poseres-book/og.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="Why frozen models fail, what a sensorimotor triplet is, and how a population of competing frames learns structure nobody specified.">
<meta name="twitter:image" content="https://impire.io/poseres-book/og.png">
